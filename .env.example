# Resend API Configuration (Auto-email delivery with custom HTML templates)
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: Set a custom verified domain sender (e.g., "Vektorsynapse Studio <hello@vektorsynapse.com>")
# If omitted, defaults to "Vektorsynapse Studio <onboarding@resend.dev>"
RESEND_FROM_EMAIL=

# Web3Forms API Configuration (Backup)
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Site URL
NEXT_PUBLIC_SITE_URL=https://vektorsynapse.netlify.app

# Google Search Console Verification Token (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
